# --- Generators / converters ---
tooltip.rfgen.rf_generator.summary=Free energy: 100,000 RF/t into neighbors
tooltip.rfgen.rf_generator.detail.1=Buffer 10,000,000 RF. Extract up to 100,000 RF/t.
tooltip.rfgen.rf_generator.detail.2=No fuel. Pushes Forge Energy to adjacent machines.
tooltip.rfgen.rf_generator.detail.3=Permanent — does not expire or convert.

tooltip.rfgen.unstable_wormhole_energy_converter.summary=10,000 RF/t for 1 hour, then Unstable Naquadah
tooltip.rfgen.unstable_wormhole_energy_converter.detail.1=Buffer 1,000,000 RF. Extract up to 10,000 RF/t.
tooltip.rfgen.unstable_wormhole_energy_converter.detail.2=Lifetime: 72,000 ticks (~60 minutes at 20 TPS).
tooltip.rfgen.unstable_wormhole_energy_converter.detail.3=When time runs out, becomes Unstable Block of Naquadah.

tooltip.rfgen.naquadah_generator.summary=5,000 RF/t for 10 minutes, then Unstable Naquadah
tooltip.rfgen.naquadah_generator.detail.1=Buffer 500,000 RF. Extract up to 5,000 RF/t.
tooltip.rfgen.naquadah_generator.detail.2=Lifetime: 12,000 ticks (~10 minutes at 20 TPS).
tooltip.rfgen.naquadah_generator.detail.3=When time runs out, becomes Unstable Block of Naquadah.

